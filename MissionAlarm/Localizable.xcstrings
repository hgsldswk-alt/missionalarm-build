    "系统闹钟 %@ 个，正在响 %@ 个": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ system alarms, %@ ringing"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统闹钟 %@ 个，正在响 %@ 个"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統鬧鐘 %@ 個，正在響 %@ 個"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムアラーム %@件、鳴動中 %@件"
          }
        }
      }
    },
    "无法读取闹钟记录": {
