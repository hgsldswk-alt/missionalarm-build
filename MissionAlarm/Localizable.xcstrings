    "保存闹钟失败，请检查权限或尝试关闭其他闹钟": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t save the alarm. Check permissions or turn off another alarm."
